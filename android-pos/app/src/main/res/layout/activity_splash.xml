<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nesty_burgundy"
    android:gravity="center"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="nesty"
            android:textColor="@color/nesty_gold"
            android:textSize="48sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART CAMPUS DINING POS"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Model 1008 • 58mm Thermal Edition"
            android:textColor="@color/nesty_gold_light"
            android:textSize="11sp"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/nesty_gold"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</RelativeLayout>
