<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order #NST-8492"
                android:textColor="@color/nesty_burgundy"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogBillCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bill Code: 10245 • Token: A7K"
                android:textColor="@color/nesty_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDialogPaymentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAID"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_badge_paid"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Student Info Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_cream"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvDialogStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student: Aarav Reddy (22B81A0501)"
            android:textColor="@color/nesty_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogTxnId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Txn: pay_P9xK2m81L"
            android:textColor="@color/nesty_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Items List Container -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ITEMS ORDERED"
        android:textColor="@color/nesty_text_secondary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvDialogItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• 2x Veg Puff (₹50.00)\n• 2x Samosa (₹24.00)"
        android:textColor="@color/nesty_text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="14dp" />

    <!-- Total Amount Paid Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_divider_top">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TOTAL PAID:"
            android:textColor="@color/nesty_burgundy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹74.00"
            android:textColor="@color/nesty_burgundy"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons: Print Bill vs Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/nesty_text_secondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogPrint"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:text="PRINT BILL"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/nesty_burgundy"
            app:cornerRadius="14dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
