<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NestyPOS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nesty_burgundy</item>
        <item name="colorPrimaryVariant">@color/nesty_burgundy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nesty_gold</item>
        <item name="colorSecondaryVariant">@color/nesty_gold</item>
        <item name="colorOnSecondary">@color/nesty_burgundy_dark</item>
        <item name="android:statusBarColor">@color/nesty_burgundy_dark</item>
        <item name="android:windowBackground">@color/nesty_cream</item>
    </style>

    <style name="Theme.NestyPOS.Splash" parent="Theme.NestyPOS">
        <item name="android:windowBackground">@color/nesty_burgundy</item>
        <item name="android:statusBarColor">@color/nesty_burgundy_dark</item>
    </style>

    <style name="KeypadButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nesty_burgundy</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="KeypadButtonClear" parent="KeypadButton">
        <item name="android:textColor">@color/nesty_error</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="KeypadButtonScan" parent="KeypadButton">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/nesty_burgundy</item>
    </style>
</resources>
