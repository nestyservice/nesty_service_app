# ============================================================================
# NESTY WEB & SHARED ANDROID/WEB BACKEND — ENVIRONMENT VARIABLES (.env.example)
# ============================================================================
# Copy this file to .env for local development.
# IMPORTANT: Never expose secret keys (JWT_SECRET, RAZORPAY_KEY_SECRET,
# SUPABASE_SERVICE_ROLE_KEY) in frontend VITE_* variables!

# Server Port (Render and Google Cloud Run inject PORT automatically)
PORT=3000
NODE_ENV=production

# Server-Side Authentication & Admin Security (NEVER exposed to browser)
JWT_SECRET=replace_with_a_strong_64_char_random_hmac_secret
ADMIN_EMAILS=admin@cvr.ac.in
ADMIN_DEFAULT_PASSWORD=admin123

# Shared Database Persistence
# By default, the server persists shared Android + Web data in ./server/data/nesty_shared_db.json
# Optional: Connect to external PostgreSQL / Supabase backend if configured
DATABASE_FILE_PATH=./server/data/nesty_shared_db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payment Gateway Configuration (Server-Side Secret vs Public Key ID)
RAZORPAY_KEY_ID=rzp_test_NestyCampusKeyId
RAZORPAY_KEY_SECRET=replace_with_server_side_razorpay_secret

# Optional Upstream Sync URL (e.g., existing Render instance)
UPSTREAM_API_URL=https://deliz-canteen.onrender.com
